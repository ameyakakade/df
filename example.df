;; define, identifier then args then return expression
;; use nil or () for no args
(define a () 5)

;; function application
(a args)

;; let bindings
(let ())

;; quotes are taken from lisp
'(1 2 3)

;; predefined fns ?
(length a)
(if (= a b) 4 6)

;; functional language, but order of evaluation is defined.

;; maybe define some functions to show output ?

;; implement only a small part in the interpreter, try to use lisp
;; macros for other constructs 

(lambda a (lambda b (lambda c 6)))

(lambda a)

(define add (lambda a (lambda b (+ a b))))
(+ 6 9)

;; the define just evals and binds the list to a name
;; when we 'call' that fn it is replaced with the lambda
;; then the eval occurs
;; we eval 6, bind it to a and replace with inner lambda
;; we eval 9, bind it to b and replace with inner lambda
;; the the inner lambda is evaluated, giving us 15

;; nil is List []

((lambda a ((+ 1 a))) 69)

;; we cannot have currying in lisp without big hacks.
;; just create a lambda when needed

(lambda (a b c) (+ a b))
