;; foldl is defined and used, to calculate 5!, and sum of 1 to 5

(define foldl
  '(lambda ('fn 'list 'acc)
     (if (cdr list)
         (foldl fn (cdr list) (fn (car list) acc) )
         acc ; Return accumulator if list is empty
         )))

(define a
  (foldl '(lambda ('v 'acc) (* v acc)) '(1 2 3 4 5) 1))
; foldl takes a lambda as argument.

(define b
  (foldl '(lambda ('v 'acc) (+ v acc)) '(1 2 3 4 5) 0))

; defining as variables so we can display results as a list

(cons a b)

