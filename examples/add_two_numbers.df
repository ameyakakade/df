; https://leetcode.com/problems/add-two-numbers/
(define add-two-numbers
  '(lambda ('list-1 'list-2)
     (let ((define or '(lambda ('a 'b) (if a 't (if b 't))))
           (define mod-10
             '(lambda ('a) (- a (* 10 (/ a 10)))))
           (define add-two-numbers-helper
             '(lambda ('l1 'l2 'carry)
             (let ((define e1 (if l1 (car l1) 0))
                   (define e2 (if l2 (car l2) 0))
                   (define res0 (+ e1 (+ e2 carry)))
                   (define carry (/ res0 10))
                   (define res (mod-10 res0)))
               (cons
                res
                (if (or l1 l2)
                    (add-two-numbers-helper (cdr l1) (cdr l2) carry)
                    (if (= carry 0) '() carry)))))))
       (add-two-numbers-helper list-1 list-2 0))))

(define map
  '(lambda ('fn 'list)
     (if list (cons (fn (car list)) (map fn (cdr list))))))

; testing the function on multiple inputs
; use the repl to test on more inputs
(define output (map '(lambda ('inps) (add-two-numbers (car inps) (car (cdr inps))))
     '(((2 4 3) (5 6 4))
       ((8) (5 6 4))
       ((0) (0))
       ((5) (5))
       ((1) (9 9 9))
       ((9 9 9 9 9 9 9) (9 9 9 9))
       (() (1 2 3))
       )))

