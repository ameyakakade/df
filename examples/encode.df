;; Problem 10 from '99 problems in Lisp'
;; https://www.ic.unicamp.br/~meidanis/courses/mc336/problemas-lisp/L-99_Ninety-Nine_Lisp_Problems.html

(define foldr
  '(lambda (f list acc)
     (if list
         (f (car list) (foldr f (cdr list) acc)) acc))) ; Return accumulator if list is empty

(define helper
  '(lambda (elem ls)
     (if ls
         ;; If acc is not empty
         (let ((define fst (car ls))
               (define felem (car fst))
               (define fnum  (car (cdr fst))))
           ;;(cons fst (cons felem fnum))
            (if (= felem elem)
                (cons (cons felem (cons (+ fnum 1) '())) (cdr ls))
                (cons (cons elem (cons 1 '())) ls)))
         ;; when acc is empty
         (cons (cons elem (cons 1 '())) '()))))

;; Encodes how many times each element was repeated.
(define encode
  '(lambda (ls)
     (foldr helper ls '())))

(encode '(a a a a b c c a a d e e e e))
;-- TEST BLOCK --
;
;Completed evaluation successfully!
;
;Results: ((a 4) (b 1) (c 2) (a 2) (d 1) (e 4))
;Output: None
